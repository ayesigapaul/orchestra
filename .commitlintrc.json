{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [2, "always", [
      "feat", "fix", "docs", "adr", "rfc", "refactor",
      "perf", "test", "build", "ci", "chore", "revert"
    ]],
    "scope-enum": [2, "always", [
      "overview", "architecture", "domain", "protocol", "governance",
      "workflows", "operations", "delivery", "reference",
      "adr", "rfc", "schemas", "ci", "repo", "deps", "release"
    ]],
    "scope-empty": [2, "never"],
    "subject-case": [2, "always", "sentence-case"],
    "header-max-length": [2, "always", 100],
    "body-max-line-length": [2, "always", 100]
  }
}
