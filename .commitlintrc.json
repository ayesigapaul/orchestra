{
  "extends": [
    "@commitlint/config-conventional"
  ],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "adr",
        "rfc",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "overview",
        "architecture",
        "domain",
        "protocol",
        "governance",
        "workflows",
        "operations",
        "delivery",
        "reference",
        "adr",
        "rfc",
        "schemas",
        "ci",
        "repo",
        "deps",
        "release",
        "services",
        "gateway",
        "supervisor",
        "runtime",
        "compiler",
        "policy",
        "audit",
        "model-broker",
        "tool-invocation",
        "control-plane",
        "admin-console",
        "infra",
        "apps",
        "tooling"
      ]
    ],
    "scope-empty": [
      2,
      "never"
    ],
    "subject-case": [
      2,
      "always",
      "sentence-case"
    ],
    "header-max-length": [
      2,
      "always",
      100
    ],
    "body-max-line-length": [
      2,
      "always",
      100
    ]
  }
}
