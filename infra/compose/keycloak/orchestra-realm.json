{
  "realm": "orchestra",
  "enabled": true,
  "sslRequired": "none",
  "organizationsEnabled": true,
  "clients": [
    {
      "clientId": "orchestra-gateway",
      "name": "Orchestra Gateway",
      "description": "The audience of an end user's access token, and the Gateway's own identity when it calls another service (ADR-0026).",
      "enabled": true,
      "publicClient": false,
      "secret": "orchestra-gateway-local-dev",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience: tenant-user-management",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "tenant-user-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "tenant-user-management",
      "name": "Tenant User Management",
      "description": "The audience of the token a service presents when it calls Tenant User Management.",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "orchestra-cli",
      "name": "Local development command line",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience: orchestra-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "orchestra-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "apisix",
      "name": "APISIX edge",
      "enabled": true,
      "publicClient": false,
      "secret": "apisix-local-dev",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "dev",
      "enabled": true,
      "email": "dev@orchestra.localhost",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "credentials": [{ "type": "password", "value": "dev-local-only", "temporary": false }]
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "username": "outsider",
      "enabled": true,
      "email": "outsider@elsewhere.localhost",
      "emailVerified": true,
      "firstName": "No",
      "lastName": "Organization",
      "credentials": [{ "type": "password", "value": "outsider-local-only", "temporary": false }]
    }
  ],
  "organizations": [
    {
      "name": "Local Tenant",
      "alias": "local-tenant",
      "enabled": true,
      "description": "The local stack's one Tenant. The tenant directory records it by this alias.",
      "domains": [{ "name": "orchestra.localhost", "verified": false }],
      "members": [{ "username": "dev", "membershipType": "UNMANAGED" }]
    }
  ]
}
